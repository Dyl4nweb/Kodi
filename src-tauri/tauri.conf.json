{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KODI",
  "version": "1.0.0",
  "identifier": "com.kodi.dynamicisland",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KODI",
        "label": "main",
        "width": 430,
        "height": 48,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "center": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Lightweight Windows Dynamic Island with Google Antigravity quota monitoring.",
    "longDescription": "KODI is a minimal, elegant, and high-performance Windows desktop application inspired by Apple's Dynamic Island and the macOS notch. Living discreetly at the top-center of the Windows desktop as a floating pill, KODI expands smoothly to present Google Antigravity AI quota monitoring, Spotify and native media controls, hardware telemetry, and productivity quick actions.",
    "copyright": "Copyright © 2026 KODI Contributors. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "autostart": {},
    "notification": {},
    "shell": {}
  }
}
